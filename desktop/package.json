{
  "name": "versaa-desktop",
  "productName": "Versaa",
  "version": "0.1.0",
  "description": "Versaa production software as a desktop app",
  "private": true,
  "main": "build/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac",
    "install:mac": "node scripts/install-mac.mjs",
    "dist:win": "node scripts/build.mjs && electron-builder --win"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.versaa.production",
    "productName": "Versaa",
    "copyright": "Versaa",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "build/main.cjs",
      "build/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/drizzle",
        "to": "drizzle"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": false,
      "installerLanguages": [
        "en_US"
      ]
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "author": "Versaa",
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false
  }
}
